# Render -> Web Service -> Environment
NODE_ENV=production
NODE_VERSION=24.x
# Copy MONGODB_URI from your existing local .env to preserve the same database.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
# Exact frontend origin; no /api. Multiple trusted origins may be comma-separated.
CLIENT_ORIGIN=https://YOUR-WEB.vercel.app
# Generate this locally; do not use this placeholder.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
TRUST_PROXY_HOPS=1
SUPPORT_AI_PROVIDER=guide
WALLET_TOPUP_RATE_LIMIT=10
# Render supplies PORT automatically. Do not copy PORT=5000 or SEED_MONGODB_URI.
