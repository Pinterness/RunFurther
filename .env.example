PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sports_event_management?replicaSet=rs0
SEED_MONGODB_URI=mongodb://127.0.0.1:27017/runfurther_dev?replicaSet=rs0
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Set to your frontend URL in production, for example: https://app.example.com
CLIENT_ORIGIN=http://localhost:3000
# 0 when running directly on your machine; 1 behind the Render service proxy
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Customer support (server only; never use NEXT_PUBLIC for the API key)
# guide | gemini — guide = built-in answers only; gemini also needs GEMINI_API_KEY, a model and AI_DAILY_LIMIT > 0
SUPPORT_AI_PROVIDER=guide
SUPPORT_AI_MODEL=
GEMINI_API_KEY=
# Max AI calls per Pacific day for the whole app (about half the free-tier daily quota); 0 or missing = never call AI
AI_DAILY_LIMIT=0

# Wallet top-up: max POST /api/wallet/topup requests per IP per minute (default 10)
WALLET_TOPUP_RATE_LIMIT=10
