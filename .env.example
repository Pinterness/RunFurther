PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sports_event_management?replicaSet=rs0
SEED_MONGODB_URI=mongodb://127.0.0.1:27017/runfurther_dev?replicaSet=rs0
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Set to your frontend URL in production, for example: https://app.example.com
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Customer support (server only; never use NEXT_PUBLIC for the API key)
# guide = built-in answers; openai = enable provider when key AND model are set
SUPPORT_AI_PROVIDER=guide
OPENAI_API_KEY=
OPENAI_MODEL=
